# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# Qloo hackathon key (request: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Hackathon keys ONLY work against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM used by the agent (Track 3). Uses your ChatGPT subscription; no API key.
# One-time sign-in: npm run llm:login   (saves a git-ignored credential file)
LLM_PROVIDER=chatgpt
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=low
CHATGPT_AUTH_FILE=.secrets/chatgpt-auth.json

# Participant intake store (Track 4, step 4.3)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
