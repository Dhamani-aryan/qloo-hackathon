# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# On Vercel, set the same variables in Project Settings → Environment Variables (see docs/DEPLOY.md).

# Qloo hackathon key (request: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
# Hackathon keys ONLY work against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM used by the agent. Uses your ChatGPT subscription; no API key.
# One-time sign-in: npm run llm:login   (saves a git-ignored credential file)
LLM_PROVIDER=chatgpt
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=low
CHATGPT_AUTH_FILE=.secrets/chatgpt-auth.json
# "file" = the local file above (development). "redis" = Upstash (required on Vercel).
# Switch to redis only after `npm run llm:push-credential`.
CHATGPT_AUTH_STORE=file

# Upstash Redis (free tier): run cache, participant links, rate limits, and the ChatGPT
# credential when CHATGPT_AUTH_STORE=redis. Without it, these fall back to server memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
